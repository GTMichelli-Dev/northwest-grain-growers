<Text>
<![CDATA[Pump_Motor_Control(PMC,Pump_Drive_Out,Pump_Drive_In,Treater_Pump,Grain_Flow_CWT,Pump_Reversed,Start_Treating);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Pump_Drive_In.Faulted)OTL(Treater_Pump.ShowStatus)MOV('Pump VFD Fault',Treater_Pump.Status_Msg);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(Pump_Drive_In.Faulted)OTU(Treater_Pump.ShowStatus)MOV('',Treater_Pump.Status_Msg);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Treater_Pump.Active_Treatment)XIC(Treater_Pump.Faulted)OTE(Treater_Pump.NotReady);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Pump_Drive_In.Faulted)OTL(Treater_Pump.ShowStatus)MOV('Pump VFD Fault',Treater_Pump.Status_Msg);]]>
</Text>
