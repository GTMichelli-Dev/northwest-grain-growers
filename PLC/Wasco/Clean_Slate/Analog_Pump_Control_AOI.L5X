<Parameter Name="Treater_Pump" TagType="Base" DataType="Treater_Pump" Usage="InOut" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags/>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOV(Analog_Raw_Counts,Values.Raw_Counts);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Values.Cal_Zero)OTU(Values.Cal_Zero)MOV(Values.Raw_Counts,Values.Zero_Counts);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Values.Cal_Span)OTU(Values.Cal_Span)GRT(Values.Raw_Counts,Values.Zero_Counts)GRT(Values.Span_Value,0)MOV(Values.Raw_Counts,Values.Span_Counts);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[GRT(Values.Span_Value,0)GRT(Values.Span_Value,0)CPT(Values.GPM,Values.Span_Value * ((Values.Raw_Counts - Values.Zero_Counts) / (Values.Span_Counts - Values.Zero_Counts)));]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[LEQ(Values.Span_Value,0)LEQ(Values.Span_Value,0)MOV(0,Values.GPM)OTE(Values.Cal_Error);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[CPT(Treater_Pump.Current_Oz_Rate,Values.GPM*128);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[CPT(Treater_Pump.Factored_Current_Oz_Rate,Treater_Pump.Current_Oz_Rate/Grain_Flow_CWT);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
<Dependencies>
<Dependency Type="DataType" Name="Treater_Pump"/>
<Dependency Type="DataType" Name="Analog_Gallon_Values"/>
</Dependencies>
</AddOnInstructionDefinition>
