<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Start_Treating)OTU(Treater_Pump.Manual_Start_Pump)OTE(Treater_Pump.Start_Pump);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[All The Pump Logic]]>
</Comment>
<Text>
<![CDATA[XIC(Treater_Pump.Start_Pump)OTU(Treater_Pump.Start_Pump_Reverse);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Treater_Pump.Start_Pump)XIO(Treater_Pump.Faulted)XIO(Treater_Pump.Purge_Forward)XIO(Treater_Pump.Purge_Reverse)OTE(PumpTreatingOn);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Default The PID Loop
]]>
</Comment>
<Text>
<![CDATA[EQU(Treater_Pump.PID.KP,0)MOV(0.65,Treater_Pump.PID.KP);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[EQU(Treater_Pump.PID.KI,0)MOV(0.1,Treater_Pump.PID.KI);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[EQU(Treater_Pump.PID.MAXS,0)MOV(500,Treater_Pump.PID.MAXS);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQU(Treater_Pump.PID.MAXO,0)MOV(100,Treater_Pump.PID.MAXO);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[EQU(Treater_Pump.PID.UPD,0)MOV(0.001,Treater_Pump.PID.UPD);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[EQU(Treater_Pump.PID.MAXI,0)MOV(500,Treater_Pump.PID.MAXI);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[EQU(Treater_Pump.PID.MAXTIE,0)MOV(9000,Treater_Pump.PID.MAXTIE);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[EQU(Treater_Pump.PID.MAXCV,0)MOV(9000,Treater_Pump.PID.MAXCV);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[EQU(Treater_Pump.PID.DB,0)MOV(2,Treater_Pump.PID.DB);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[EQU(Treater_Pump.PID_Activate_Delay,0)MOV(5000,Treater_Pump.PID_Activate_Delay);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[MOV(Treater_Pump.PID_Activate_Delay,tmrPIDDelay.PRE);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[CPT(Treater_Pump.Speed_Percent,(Treater_Pump.Speed/Treater_Pump.PID.MAXCV)*100);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[LEQ(Treater_Pump.PID_Activate_Delay,0)MOV(500,Treater_Pump.PID_Activate_Delay);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[MOV(Treater_Pump.PID_Activate_Delay,tmrPIDDelay.PRE);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(Treater_Pump.Start_Pump)XIO(Treater_Pump.TreaterScale.Adding_Weight)XIO(Treater_Pump.Faulted)XIO(Treater_Pump.Purge_Forward)XIO(Treater_Pump.Purge_Reverse)GRT(Treater_Pump.PID.SP,0)TON(tmrPIDDelay,?,?);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[EQU(Grain_Flow_CWT,0)MOV(1,Grain_Flow_CWT);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[CPT(Treater_Pump.Factored_Target_Oz_Rate,Treater_Pump.Target_Oz_Rate*Grain_Flow_CWT);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[MOV(Treater_Pump.Factored_Target_Oz_Rate,Treater_Pump.PID.SP);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(tmrPIDDelay.DN)XIO(Treater_Pump.Over_Speed_Limit)XIC(Treater_Pump.Auto_Tune)PID(Treater_Pump.PID,Treater_Pump.Current_Oz_Rate,0,Treater_Pump.Speed,0,0,0);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[[[XIC(Treater_Pump.Start_Pump) ,XIC(Treater_Pump.Manual_Start_Pump) ] XIO(Pump_Reversed) ,XIC(Treater_Pump.Purge_Forward) XIO(Pump_Reversed) ,XIC(Treater_Pump.Purge_Reverse) XIC(Pump_Reversed) ,XIC(Pump_Reversed) XIC(Treater_Pump.Start_Pump_Reverse) ]OTE(Pump_Drive_Out.Forward);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[[[XIC(Treater_Pump.Start_Pump) ,XIC(Treater_Pump.Manual_Start_Pump) ] XIC(Pump_Reversed) ,XIC(Treater_Pump.Purge_Forward) XIC(Pump_Reversed) ,XIC(Treater_Pump.Purge_Reverse) XIO(Pump_Reversed) ,XIO(Pump_Reversed) XIC(Treater_Pump.Start_Pump_Reverse) ]OTE(Pump_Drive_Out.Reverse);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIO(Treater_Pump.Faulted)[XIC(Treater_Pump.Start_Pump) ,XIC(Treater_Pump.Manual_Start_Pump) ,XIC(Treater_Pump.Purge_Forward) ,XIC(Treater_Pump.Purge_Reverse) ]OTE(Pump_Drive_Out.Start);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[[XIO(Treater_Pump.Start_Pump) XIO(Treater_Pump.Manual_Start_Pump) XIO(Treater_Pump.Start_Pump_Reverse) XIO(Treater_Pump.Purge_Forward) XIO(Treater_Pump.Purge_Reverse) ,XIO(Treater_Pump.Purge_Forward) XIO(Treater_Pump.Purge_Reverse) XIO(Treater_Pump.Manual_Start_Pump) XIC(Treater_Pump.Below_Min_Gals) ,XIC(Treater_Pump.Faulted) ]OTE(Pump_Drive_Out.Stop);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[XIC(Treater_Pump.Product.Accept_New)[COP(Treater_Pump.Product.New_Product,Treater_Pump.Product.Description,1) ,OTU(Treater_Pump.Product.Edit_Product) OTU(Treater_Pump.Product.Accept_New) ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[XIC(Treater_Pump.Product.Cancel_New)OTU(Treater_Pump.Product.Edit_Product)OTU(Treater_Pump.Product.Cancel_New);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[Clear Fault In Drive]]>
</Comment>
<Text>
<![CDATA[XIC(Treater_Pump.Clear_Faults)OTU(Treater_Pump.Over_Speed_Limit)OTE(Pump_Drive_Out.ClearFaults);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[XIO(Pump_Drive_In.Faulted)OTU(Treater_Pump.Clear_Faults);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[Output showing pump is faulted]]>
</Comment>
<Text>
<![CDATA[XIC(Pump_Drive_In.Faulted)OTE(Treater_Pump.Faulted);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[Set Drive Speed]]>
</Comment>
<Text>
<![CDATA[XIO(Treater_Pump.Purge_Forward)XIO(Treater_Pump.Purge_Reverse)MOV(Treater_Pump.Speed,Pump_Drive_Out.FreqCommand);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[LEQ(Treater_Pump.Purge_Percent,0)MOV(0.5,Treater_Pump.Purge_Percent);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[Set Drive Speed]]>
</Comment>
<Text>
<![CDATA[[XIC(Treater_Pump.Purge_Forward) ,XIC(Treater_Pump.Purge_Reverse) ]CPT(Pump_Drive_Out.FreqCommand,9000*Treater_Pump.Purge_Percent);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[Current Speed Of Pump from 0 to 9000]]>
</Comment>
<Text>
<![CDATA[MOV(Pump_Drive_In.OutputFreq,Treater_Pump.Current_Speed);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[To get the rpm of the motor we need to have a speed factor to multliply the freq drive frequency by.
If the pump speed factor is 0 then we will use a default value]]>
</Comment>
<Text>
<![CDATA[CMP(Treater_Pump.Speed_Factor=0)MOV(0.066,Treater_Pump.Speed_Factor);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Comment>
<![CDATA[Set the Pumps RPM]]>
</Comment>
<Text>
<![CDATA[MUL(Treater_Pump.Current_Speed,Treater_Pump.Speed_Factor,Treater_Pump.Current_RPM);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Text>
<![CDATA[LEQ(Treater_Pump.SpeedLimitPercent,0)MOV(0.7,Treater_Pump.SpeedLimitPercent);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Text>
<![CDATA[CPT(OverSpeedLimit,9000*Treater_Pump.SpeedLimitPercent);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Text>
<![CDATA[LEQ(Treater_Pump.Over_Speed_Time_Out,0)MOV(5000,Treater_Pump.Over_Speed_Time_Out);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[LEQ(Treater_Pump.Over_Speed_Reset_Time,0)MOV(5000,Treater_Pump.Over_Speed_Reset_Time);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Text>
<![CDATA[[LEQ(Treater_Pump.Limp_Mode_Speed_Percent,0) ,GEQ(Treater_Pump.Limp_Mode_Speed_Percent,0.99) ]MOV(0.3,Treater_Pump.Limp_Mode_Speed_Percent);]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Text>
<![CDATA[MOV(Treater_Pump.Over_Speed_Time_Out,tmrOverSpeedReset.PRE)MOV(Treater_Pump.Over_Speed_Time_Out,tmrOverSpeed.PRE);]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Text>
<![CDATA[GEQ(Treater_Pump.Speed,OverSpeedLimit)XIO(Treater_Pump.Manual_Start_Pump)XIO(Treater_Pump.Purge_Forward)XIO(Treater_Pump.Purge_Reverse)XIC(Treater_Pump.Start_Pump)XIO(Treater_Pump.Ack_Over_Speed)TON(tmrOverSpeed,?,?);]]>
</Text>
</Rung>
<Rung Number="44" Type="N">
<Text>
<![CDATA[XIC(tmrOverSpeed.DN)CPT(Pump_Drive_Out.FreqCommand,Treater_Pump.Limp_Mode_Speed_Percent*9000)OTL(Treater_Pump.Over_Speed_Limit);]]>
</Text>
</Rung>
<Rung Number="45" Type="N">
<Text>
<![CDATA[XIC(Treater_Pump.Ack_Over_Speed)OTU(Treater_Pump.Ack_Over_Speed);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
<Dependencies>
<Dependency Type="DataType" Name="Treater_Pump"/>
