<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[CMP(Scale.Rate_Tol<=0)MOV(1,Scale.Rate_Tol);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOV(Scale_Input.Data[0],Scale.Gross);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(Rate_Tmr.DN)[CMP(ABS(Scale.Avg_Rate-Old_Accum_Rate)-Scale.Rate_Tol<=0) MOV(1,Lock_Stable_Rate) ,CMP(ABS(Scale.Avg_Rate-Old_Accum_Rate)-Scale.Rate_Tol>0) MOV(0,Lock_Stable_Rate) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(tmr_Old_Rate.DN)TON(tmr_Old_Rate,?,?);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(tmr_Old_Rate.DN)MOV(Scale.Avg_Rate,Old_Accum_Rate);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[CMP(Lock_Stable_Rate>0)TON(tmr_Stable,?,?);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(tmr_Stable.DN)OTE(Scale.Rate_Stable);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
