<Routines>
<Routine Name="AddWeights" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[CPT(Weight_Sum[ScaleIDX],Weight_Array[ScaleIDX,ShiftIDX+1]-Weight_Array[ScaleIDX,ShiftIDX]+Weight_Sum[ScaleIDX]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[FOR(Scale_Data,ScaleIDX,0,1,1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Scale_Data" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(ctrWtArray[ScaleIDX].DN)RES(ctrWtArray[ScaleIDX]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(tmrRate[ScaleIDX].DN)TON(tmrRate[ScaleIDX],?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(tmrRate[ScaleIDX].DN)CPT(Weight_Array_Idx[ScaleIDX],Weight_Array_Idx[ScaleIDX]+1)CTU(ctrWtArray[ScaleIDX],?,?);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[GEQ(Weight_Array_Idx[ScaleIDX],20)MOV(0,Weight_Array_Idx[ScaleIDX]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[MOV(Weight_Array_Idx[ScaleIDX],Cur_Weight_Array_Idx);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(tmrTestRate[ScaleIDX].DN)TON(tmrTestRate[ScaleIDX],?,?);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[MOV(TreaterScale[ScaleIDX].Gross,Current_Gross[ScaleIDX]);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(tmrTestRate[ScaleIDX].DN)AFI()CPT(Current_Gross[ScaleIDX],Current_Gross[ScaleIDX]+Scale_Test_Rate_Mlt);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(tmrRate[ScaleIDX].DN)[FOR(ShiftWeight,ShiftIDX,0,1,1) ,MOV(Current_Gross[ScaleIDX],Weight_Array[ScaleIDX,20]) ,AFI() MOV(tmrRate[ScaleIDX].ACC,Time_Array[ScaleIDX,Cur_Weight_Array_Idx]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[MOV(0,Weight_Sum[ScaleIDX])MOV(0,Prev_Weight[ScaleIDX])FOR(AddWeights,ShiftIDX,0,4,1);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[MOV(Weight_Sum[ScaleIDX],Prev_Weight[ScaleIDX])MOV(0,Weight_Sum[ScaleIDX])MOV(0,Cur_Weight[ScaleIDX])FOR(AddWeights,ShiftIDX,10,19,1);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[MOV(Weight_Sum[ScaleIDX],Cur_Weight[ScaleIDX]);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[CPT(TreaterScale[ScaleIDX].Rate,Cur_Weight[ScaleIDX]/10*60) ,ABS(TreaterScale[ScaleIDX].Rate,TreaterScale[ScaleIDX].Rate) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[CPT(TreaterScale[ScaleIDX].Avg_Rate,TreaterScale[ScaleIDX].Rate);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[CPT(TestRate[ScaleIDX],Weight_Array[ScaleIDX,20]-Weight_Array[ScaleIDX,19]);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[CMP(TreaterScale[ScaleIDX].Product_Mult<=0)MOV(1,TreaterScale[ScaleIDX].Product_Mult);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[CPT(TreaterScale[ScaleIDX].Fluid_Rate,TreaterScale[ScaleIDX].Rate*0.01/TreaterScale[ScaleIDX].Product_Mult*128/2);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ShiftWeight" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOV(Weight_Array[ScaleIDX,ShiftIDX+1],Weight_Array[ScaleIDX,ShiftIDX]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
