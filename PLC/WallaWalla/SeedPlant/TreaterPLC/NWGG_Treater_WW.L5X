<Routines>
<Routine Name="Test" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Figure Out Whate Data Points Need To Be Used Based On The Rate Desired
]]>
</Comment>
<Text>
<![CDATA[CMP(Rate<0)MOV(0,Rate);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[SUB(Next_Index,1,Next_Index);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[CMP(Next_Index<0)MOV(9,Next_Index);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[CMP(Rate>=Cal_Points.Cal_Point[Next_Index].Rate)[CMP(Next_Index=9) ,CMP(Next_Index<9) CMP(Rate<Cal_Points.Cal_Point[Next_Index+1].Rate) ]MOV(Next_Index,Index);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Get the Two Points for the Calculations
if at the top of the graph use the last 2 (index 9 and 8)]]>
</Comment>
<Text>
<![CDATA[CMP(Index=9)[MOV(9,CP_Index_1) ,MOV(8,CP_Index_2) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[CMP(Index<9)[MOV(Index,CP_Index_1) ,ADD(Index,1,CP_Index_2) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Do the Math
]]>
</Comment>
<Text>
<![CDATA[CPT(Rate_Delta,Cal_Points.Cal_Point[CP_Index_1].Rate-Cal_Points.Cal_Point[CP_Index_2].Rate);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[CPT(Speed_Delta,Cal_Points.Cal_Point[CP_Index_1].Speed-Cal_Points.Cal_Point[CP_Index_2].Speed);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[CMP(Speed_Delta<>0)CPT(Slope,Speed_Delta/Rate_Delta);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[CMP(Speed_Delta=0)MOV(0,Slope);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[CPT(Zero_Offset,-Slope*Cal_Points.Cal_Point[CP_Index_1].Rate+Cal_Points.Cal_Point[CP_Index_1].Speed);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[CPT(Speed,Slope*Rate+Zero_Offset);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
