<Routines>
<Routine Name="Color" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[If They Need Color then turn off manual run of Pumps]]>
</Comment>
<Text>
<![CDATA[XIC(Start_Color)OTL(Manual_Stop_Pumps);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[If One Of the pumps is in Manual Mode then Get out of the routine]]>
</Comment>
<Text>
<![CDATA[[XIC(Treater_Pump[20].Manual_Start_Pump) ,XIC(Treater_Pump[21].Manual_Start_Pump) ,XIC(Treater_Pump[22].Manual_Start_Pump) ,XIC(Treater_Pump[23].Manual_Start_Pump) ]TND();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[MOV(Primary_Color_Index,Current_Color_Index);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Not Used right now]]>
</Comment>
<Text>
<![CDATA[XIC(Secondary_Color_In_Use)AFI()MOV(Secondary_Color_Index,Current_Color_Index);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Adjust Value For Cyan (BLUE)
]]>
</Comment>
<Text>
<![CDATA[XIC(Adjust_Cyan_Up)XIO(tmr_Adj_Cyan_UP.DN)TON(tmr_Adj_Cyan_UP,?,?)XIO(tmr_Adj_Cyan_UP.TT)ADD(Colors[Current_Color_Index].Blue,0.001,Colors[Current_Color_Index].Blue)GRT(Colors[Current_Color_Index].Blue,1)OTL(Color_Adjusted)MOV(1,Colors[Current_Color_Index].Blue);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Adjust_Cyan_Dn)XIO(tmr_Adj_Cyan_Down.DN)TON(tmr_Adj_Cyan_Down,?,?)XIO(tmr_Adj_Cyan_Down.TT)SUB(Colors[Current_Color_Index].Blue,0.001,Colors[Current_Color_Index].Blue)LES(Colors[Current_Color_Index].Blue,0)OTL(Color_Adjusted)MOV(0,Colors[Current_Color_Index].Blue);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Adjust Value For Yellow
]]>
</Comment>
<Text>
<![CDATA[XIC(Adjust_Yellow_Up)XIO(tmr_Adj_Yellow_UP.DN)TON(tmr_Adj_Yellow_UP,?,?)XIO(tmr_Adj_Yellow_UP.TT)ADD(Colors[Current_Color_Index].Yellow,0.001,Colors[Current_Color_Index].Yellow)GRT(Colors[Current_Color_Index].Yellow,1)OTL(Color_Adjusted)MOV(1,Colors[Current_Color_Index].Yellow);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Adjust_Yellow_Dn)XIO(tmr_Adj_Yellow_Down.DN)TON(tmr_Adj_Yellow_Down,?,?)XIO(tmr_Adj_Yellow_Down.TT)SUB(Colors[Current_Color_Index].Yellow,0.001,Colors[Current_Color_Index].Yellow)LES(Colors[Current_Color_Index].Yellow,0)OTL(Color_Adjusted)MOV(0,Colors[Current_Color_Index].Yellow);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Adjust Value For Red
]]>
</Comment>
<Text>
<![CDATA[XIC(Adjust_Red_Up)XIO(tmr_Adj_Magenta_UP.DN)TON(tmr_Adj_Magenta_UP,?,?)XIO(tmr_Adj_Magenta_UP.TT)ADD(Colors[Current_Color_Index].Red,0.001,Colors[Current_Color_Index].Red)GRT(Colors[Current_Color_Index].Red,1)OTL(Color_Adjusted)MOV(1,Colors[Current_Color_Index].Red);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Adjust_Red_Dn)XIO(tmr_Adj_Magenta_Down.DN)TON(tmr_Adj_Magenta_Down,?,?)XIO(tmr_Adj_Magenta_Down.TT)SUB(Colors[Current_Color_Index].Red,0.001,Colors[Current_Color_Index].Red)LES(Colors[Current_Color_Index].Red,0)OTL(Color_Adjusted)MOV(0,Colors[Current_Color_Index].Red);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Adjust Value For White
]]>
</Comment>
<Text>
<![CDATA[XIC(Adjust_White_Up)XIO(tmr_Adj_White_UP.DN)TON(tmr_Adj_White_UP,?,?)XIO(tmr_Adj_White_UP.TT)ADD(Colors[Current_Color_Index].White,0.001,Colors[Current_Color_Index].White)GRT(Colors[Current_Color_Index].White,1)OTL(Color_Adjusted)MOV(1,Colors[Current_Color_Index].White);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Adjust_White_Dn)XIO(tmr_Adj_White_Down.DN)TON(tmr_Adj_White_Down,?,?)XIO(tmr_Adj_White_Down.TT)SUB(Colors[Current_Color_Index].White,0.001,Colors[Current_Color_Index].White)LES(Colors[Current_Color_Index].White,0)OTL(Color_Adjusted)MOV(0,Colors[Current_Color_Index].White);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[MOV(Primary_On,tmrPrimary_Duration.PRE) ,MOV(Secondary_On,tmrSecondary_Duration.PRE) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[CPT(Qtr_Total,Total_Oz_Min*0.25);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[CPT(Third_Total,Total_Oz_Min*0.333);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[GRT(Secondary_Color_Index,0)OTE(Use_Secondary);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIO(tmr_Strip_Flush2.DN)CPT(tmrPrimary_Duration.PRE,Primary_Duration*1000)TON(tmrPrimary_Duration,?,?);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(tmrPrimary_Duration.DN)XIC(Use_Secondary)CPT(tmr_Strip_Flush.PRE,Flush_Duration*1000)TON(tmr_Strip_Flush,?,?);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(tmrPrimary_Duration.DN)XIC(tmr_Strip_Flush.DN)XIC(Use_Secondary)CPT(tmrSecondary_Duration.PRE,Secondary_Duration*1000)TON(tmrSecondary_Duration,?,?);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(tmrSecondary_Duration.DN)XIC(Use_Secondary)CPT(tmr_Strip_Flush2.PRE,Flush2_Duration*1000)TON(tmr_Strip_Flush2,?,?);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[XIC(tmrPrimary_Duration.TT) ,XIO(Use_Secondary) ][MOV(Colors[Primary_Color_Index].Blue,Cyan_Percent) ,MOV(Colors[Primary_Color_Index].Yellow,Yellow_Percent) ,MOV(Colors[Primary_Color_Index].Red,Magenta_Percent) ,MOV(Colors[Primary_Color_Index].White,White_Percent) ,MOV(Colors[Primary_Color_Index].Polymer,Water_Percent) ,OTE(Primary_Color_In_Use) ,COP(Colors[Primary_Color_Index].Description,Current_Color_Description,Colors[Primary_Color_Index].Description.LEN) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[[XIC(tmr_Strip_Flush.TT) ,XIC(tmr_Strip_Flush2.TT) ][MOV(0,Cyan_Percent) ,MOV(0,Yellow_Percent) ,MOV(0,Magenta_Percent) ,MOV(0,White_Percent) ,OTE(Flushing_In_Use) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(tmr_Strip_Flush.TT)COP(FlushDescription[0],Current_Color_Description,Flush_Description.LEN)CPT(Flush_Seconds,tmr_Strip_Flush.PRE/1000);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(tmr_Strip_Flush2.TT)COP(FlushDescription[1],Current_Color_Description,Flush_Description.LEN)CPT(Flush_Seconds,tmr_Strip_Flush2.PRE/1000);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(tmrSecondary_Duration.TT)XIC(Use_Secondary)[MOV(Colors[Secondary_Color_Index].Blue,Cyan_Percent) ,MOV(Colors[Secondary_Color_Index].Yellow,Yellow_Percent) ,MOV(Colors[Secondary_Color_Index].Red,Magenta_Percent) ,MOV(Colors[Secondary_Color_Index].White,White_Percent) ,MOV(Colors[Secondary_Color_Index].Polymer,Water_Percent) ,OTE(Secondary_Color_In_Use) ,COP(Colors[Secondary_Color_Index].Description,Current_Color_Description,Colors[Secondary_Color_Index].Description.LEN) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[CPT(Treater_Pump[20].Rate,Cyan_Percent*(Total_Oz_Min/2));]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[CPT(Treater_Pump[21].Rate,Yellow_Percent*(Total_Oz_Min/2));]]>
</Text>
</Rung>
