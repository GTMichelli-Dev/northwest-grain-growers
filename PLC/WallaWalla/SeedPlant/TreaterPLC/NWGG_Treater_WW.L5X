<AddOnInstructionDefinition Name="Active_Treater_Pump" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2017-04-25T14:09:46.902Z" CreatedBy="MIDWAY-NUC\Administrator" EditedDate="2017-09-15T03:56:30.194Z" EditedBy="MIDWAY-NUC\Tech" SoftwareRevision="v28.02">
<Description>
<![CDATA[The active Pump Values]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="Treater_Pump" TagType="Base" DataType="Treater_Pump" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="Active_Pump_Values" TagType="Base" DataType="Active_Pump_Values" Usage="InOut" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags/>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Treater_Pump.Active_Treatment)OTE(Active_Pump_Values.In_Use);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[COP(Treater_Pump.Description,Active_Pump_Values.Pump_Description,1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[COP(Treater_Pump.Product,Active_Pump_Values.Product,1);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Treater_Pump.Faulted)OTE(Active_Pump_Values.Faulted);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Active_Pump_Values.Clear_Fault)OTU(Active_Pump_Values.Clear_Fault)OTE(Treater_Pump.Clear_Faults);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[MOV(Treater_Pump.Current_Speed,Active_Pump_Values.Current_Speed);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Treater_Pump.Manual_Start_Pump)OTE(Active_Pump_Values.Manual_Mode);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[MOV(Treater_Pump.Current_RPM,Active_Pump_Values.Current_RPM);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[MOV(Treater_Pump.Rotor_Animate_IDX,Active_Pump_Values.Rotor_Animate_IDX);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
